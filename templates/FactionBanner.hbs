<div
    class="flex column align-center faction-banner {{level}}"
    data-faction-id="{{id}}"
>
    <div class="banner-frame"></div>
    {{#if @root.isOwner}}
    <div class="ax-dropdown faction-options">
        <button
            type="button"
            class="faction-options-trigger ax-icon-button ghost"
            data-action="toggleDropdown"
            aria-label="Faction options"
            aria-haspopup="true"
            title="Faction Options"
        >
            <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>
        <div class="ax-dropdown-menu ax-menu">
            <button
                type="button"
                class="ax-menu-item"
                data-action="removeFaction"
                data-faction-id="{{id}}"
            >
                <span class="ax-menu-label">Delete Faction</span>
            </button>
        </div>
    </div>
    {{/if}}
    <div class="flex column gap-2 items-center w-full p-3">
        <div class="faction-symbol {{level}}">
            <div class="symbol-inner">
                <span>{{reputation}}</span>
            </div>
        </div>
        <div class="faction-name mb-2">{{name}}</div>
        <span class="ax-tag {{level}}">
            <span class="inner">{{levelLabel}}</span>
        </span>
    </div>

    <div
        class="banner-activity w-full flex-1 flex column gap-2 align-center justify-between"
    >
        {{#if hasEvents}} {{#each recentEvents}}

        <div
            class="event-entry-amount {{#if positive}}positive{{else}}negative{{/if}}"
        >
            {{sign}}{{amount}}
        </div>
        <div class="activity-title flex flex-1 items-center align-center">
            <span>{{note}}</span>
        </div>
        <div class="timestamp">{{date}}</div>

        {{/each}} {{else}}
        <div class="no-activity flex w-full h-full items-center align-center">
            No activity yet
        </div>
        {{/if}}
    </div>
</div>
